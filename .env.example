# Copy this file to .env and adjust. .env is gitignored; never commit real secrets.
#
# NOTE (LC-006): Docker Compose reads .env, but the Spring apps and Makefile do not yet.
# Until that is fixed, either keep these values equal to the defaults in
# shipment-service/src/main/resources/application.properties, or export the same
# variables in your shell / IDE run configuration.

# -----------------------------------
# PostgreSQL Database Configuration
# -----------------------------------
POSTGRES_DB=logistics_db
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=change_me

# -----------------------------------
# ActiveMQ Artemis Configuration
# -----------------------------------
ARTEMIS_USER=admin
ARTEMIS_PASSWORD=artemis_secure_password
